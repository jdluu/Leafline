<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only override: same as main plus the user anchor, so a local proxy
     (mitmproxy, Charles) can inspect HTTPS without weakening release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
