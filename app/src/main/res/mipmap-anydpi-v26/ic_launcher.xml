<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand field: deep green-teal, shared with the splash screen. -->
    <background android:drawable="@color/ic_launcher_background" />
    <!-- The leaf mark, extracted from the brand illustration, centered
         in the 108dp canvas within the 66dp safe zone. -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icon (Android 13+): the same leaf, system-tinted. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
