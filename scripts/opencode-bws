#!/usr/bin/env bash
set -euo pipefail

# Resolve OpenCode's OpenRouter credential at launch; never persist it to disk.
if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
  printf '%s\n' 'BWS_ACCESS_TOKEN is required to use opencode-bws.' >&2
  exit 1
fi

secret_json="$(bws secret list -o json)"
export OPENROUTER_API_KEY="$(printf '%s' "$secret_json" | python3 -c '
import json
import sys

secrets = json.load(sys.stdin)
for secret in secrets:
    if secret.get("key") == "OPENCODE_OPENROUTER_API_KEY":
        value = secret.get("value", "")
        if value:
            print(value, end="")
            break
else:
    raise SystemExit("BWS secret OPENCODE_OPENROUTER_API_KEY was not found")
')"
unset secret_json

exec opencode "$@"

